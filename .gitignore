# Rust build
target/

# Operating system and temporary files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
$RECYCLE.BIN/


# Whisper neural models (large binaries downloaded on demand)
# The ggml-large-v3-turbo.bin model is ~1.6 GB and is downloaded when dictation is installed
whisper/models/*.bin
!whisper/models/README.md
!whisper/models/.gitkeep

# Temporary files and heavy GPU binaries downloaded by the app
whisper/*.zip
whisper/bin-cuda/

# Of the precompiled whisper.cpp binaries the app only uses whisper-cli and its DLLs: the examples,
# tests and tools that come in the package (and the DLLs only they use) stay out of the repository.
whisper/bin-*/**/*.exe
!whisper/bin-*/**/whisper-cli.exe
whisper/bin-*/**/llama.dll
whisper/bin-*/**/SDL2.dll
whisper/bin-*/**/parakeet.dll

# External whisper.cpp source and intermediate build folders
whisper/src/

# Local runtime data (attachments, screenshots, sessions, tasks)
# (everything in data/ stays out, except the README and the empty attachments/ folder)
data/*
!data/README.md
!data/attachments/
data/attachments/*
!data/attachments/.gitkeep
# The data folder of older versions (moved to data/ on the next start)
dados/

# Logs and local environment variables
*.log
.env
.env.local

# Development environments and IDEs
.vscode/
.idea/
.gemini/

# Temporary agent worktrees (Claude Code)
.claude/worktrees/

# Worktrees and folders of the AgentDeck tasks desk
/.agentdeck/
