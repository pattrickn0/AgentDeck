# Shell scripts run in bash on Windows too (CI): no CRLF.
*.sh text eol=lf

# PTY recordings used by the tests: exact bytes, no line ending conversion.
crates/app/src/terminal/testdata/* -text

# Each task adds its line at the top of the history, and two tasks in parallel conflicted there on every
# merge. "union" joins the lines of both sides (the file only gets new entries, it does not edit old ones).
memory/history.md merge=union
